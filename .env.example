# Copy to .env and fill in. Only the tools read this (building the TV app, deploying,
# printing an invite); the server itself needs no configuration.

# The address your TV, phone and computer use to reach the server.
MY_STREAMS_URL=http://192.168.1.50:8765

# Optional: deploy from this computer to the server over SSH (npm run deploy, npm run invite).
# MY_STREAMS_SSH=you@your-server
# MY_STREAMS_DIR=apps/my-streams      # folder on the server, relative to your home there

# Optional: the name you gave your TV in LG's command-line tools (npm run install:tv).
# MY_STREAMS_TV=tv
